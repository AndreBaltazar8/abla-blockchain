import "abla/crypto"
import "abla/crypto/bignum"
import "abla/process/exit"
import "field.ab"

// Signing with Ed25519, RFC 8032, deterministic by its own design. Each multiplication is 256 doublings and additions by the complete formula on extended
// coordinates (Hisil et al., add-2008-hwcd-3), with the result selected by mask. The seed's hash and the nonce stay in secret types until the signature.

private val ED_P = "7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffed"
private val ED_L = "1000000000000000000000000000000014def9dea2f79cd65812631a5cf5d3ed"
private val ED_P_MINUS_2 = "7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeb"
private val ED_GX = "216936d3cd6e53fec0a4e231fdd6dc5c692cc7609525a7b2c9562d608f25d51a"
private val ED_GY = "6666666666666666666666666666666666666666666666666666666666666658"
private val ED_2D = "2406d9dc56dffce7198e80f2eef3d13000e0149a8283b156ebd69b9426b2f159"
// A point in extended coordinates: X, Y, Z, T, each a number of the field.
private resource class EdPoint(val x: BigNumber, val y: BigNumber, val z: BigNumber, val t: BigNumber)

// The numbers one addition works in, made once for a whole multiplication.
private resource class EdWork(val a: BigNumber, val b: BigNumber, val c: BigNumber, val d: BigNumber, val e: BigNumber, val h: BigNumber)

private fun edWork(field: BigModulus): EdWork = EdWork(field.zero(), field.zero(), field.zero(), field.zero(), field.zero(), field.zero())

// out = P + Q for a = -1, complete, and it doubles too (out may be P or Q). `k` is 2 * d in the field.
private fun edAddPoints(out: EdPoint, p: EdPoint, q: EdPoint, k: BigNumber, w: EdWork): void {
    w.a.setSub(p.y, p.x)
    w.e.setSub(q.y, q.x)
    w.a.setMul(w.a, w.e)
    w.b.setAdd(p.y, p.x)
    w.e.setAdd(q.y, q.x)
    w.b.setMul(w.b, w.e)
    w.c.setMul(p.t, q.t)
    w.c.setMul(w.c, k)
    w.d.setMul(p.z, q.z)
    w.d.setAdd(w.d, w.d)
    w.e.setSub(w.b, w.a)
    w.h.setAdd(w.b, w.a)
    w.a.setSub(w.d, w.c)
    w.b.setAdd(w.d, w.c)
    out.x.setMul(w.e, w.a)
    out.y.setMul(w.b, w.h)
    out.t.setMul(w.e, w.h)
    out.z.setMul(w.a, w.b)
}
// The 32-byte encoding of `scalar` (a number of the base point's order L) times the base point.
private fun edBaseEncoded(scalar: BigNumber): string {
    val field = walletModulus(ED_P)
    val k = walletNumber(field, ED_2D)
    val gx = walletNumber(field, ED_GX)
    val gy = walletNumber(field, ED_GY)
    val gt = gx.mul(gy)
    val g = EdPoint(move(gx), move(gy), field.one(), move(gt))
    val w = edWork(field)
    // The neutral point: 0, 1, 1, 0.
    val r = EdPoint(field.zero(), field.one(), field.one(), field.zero())
    val q = EdPoint(field.zero(), field.zero(), field.zero(), field.zero())
    var bit = 255
    while (bit >= 0) {
        edAddPoints(r, r, r, k, w)
        edAddPoints(q, r, g, k, w)
        val mask = scalar.bitMask(bit)
        r.x.setSelect(q.x, r.x, mask)
        r.y.setSelect(q.y, r.y, mask)
        r.z.setSelect(q.z, r.z, mask)
        r.t.setSelect(q.t, r.t, mask)
        bit = bit - 1
    }
    val inverse = r.z.pow(walletBytesOf(ED_P_MINUS_2))
    // A point's encoding is public wherever it's used.
    val out = r.y.mul(inverse).toBytes(false)
    val parity = int(r.x.mul(inverse).toBytes(false)[0]) & 1
    out.slice(0, 31) + cryptoByteString([int(out[31]) | (parity << 7)])
}
// The scalar of a seed's hash: its first 32 bytes, little-endian, with the low three bits and the top bit cleared and the second from the top set (RFC 8032, 5.1.5).
// It may be above L, which does not change the point it makes from the base point, whose order is L.
private fun edClamped(scalars: BigModulus, digest: string): BigNumber {
    val bytes: array<int> = []
    for (i in 0 until 32) bytes.append(int(digest[i]))
    bytes[0] = bytes[0] & 248
    bytes[31] = (bytes[31] & 127) | 64
    scalars.reduce(cryptoByteString(bytes), false) ?? panic("wallet: a clamped scalar did not reduce")
}
fun ed25519PublicKeyOf(seed: string): string {
    if (seed.size != 32) return ""
    val scalars = walletModulus(ED_L)
    edBaseEncoded(edClamped(scalars, sha512(seed)))
}
// A 64-byte hash reduced modulo L, little-endian.
private fun edWideScalar(scalars: BigModulus, wide: string): BigNumber = scalars.reduce(wide, false) ?? panic("wallet: a hash did not reduce")
// 64 bytes, or "" for a seed that isn't 32.
fun ed25519Sign(seed: string, message: string): string {
    if (seed.size != 32) return ""
    val scalars = walletModulus(ED_L)
    val digest = sha512(seed)
    val a = edClamped(scalars, digest)
    val key = edBaseEncoded(a)
    val r = edWideScalar(scalars, sha512(digest.slice(32, 64) + message))
    val point = edBaseEncoded(r)
    val k = edWideScalar(scalars, sha512(point + key + message))
    point + k.mul(a).add(r).toBytes(false)
}
