import "abla/crypto"
import "abla/crypto/bignum"
import "abla/ct"
import "abla/process/exit"

// What signing needs of big numbers: a modulus of 256 bits made from a hex constant, and a constant-time range check of a secret. The arithmetic is abla/crypto/bignum's
// BigModulus and BigNumber (Montgomery multiplication, constant-time addition, subtraction and selection, no address in sight); every step of the curves below is a
// method of them, and a value is only a plain string where it is public by design: a public key, r, s. docs/signing.md says what that's worth.

private fun hexDigits(hex: string): array<int> {
    val out: array<int> = []
    var i = 0
    while (i < hex.size) {
        out.append(walletNibble(hex[i]) * 16 + walletNibble(hex[i + 1]))
        i = i + 2
    }
    out
}
private fun walletNibble(c: int): int = if (c >= 97) c - 87 else c - 48
fun walletBytesOf(hex: string): string = cryptoByteString(hexDigits(hex))

/// A modulus from a public hex constant of 64 digits.
fun walletModulus(hex: string): BigModulus = bigModulus(walletBytesOf(hex)) ?? panic("wallet: a curve constant is not a modulus")

/// A public hex constant (64 digits) below `modulus`, as a number of it.
fun walletNumber(modulus: BigModulus, hex: string): BigNumber = modulus.number(walletBytesOf(hex)) ?? panic("wallet: a curve constant is out of range")

// Whether 0 < value < limit, big-endian and 32 bytes each, reading every byte. Only the answer is public: a key or nonce refused is thrown away.
fun walletInRange(value: string, limit: string): bool {
    var borrow = secretU32(u32(0))
    var any = secretU32(u32(0))
    var i = 31
    while (i >= 0) {
        val x = secretU32(u32(int(value[i])))
        val y = secretU32(u32(int(limit[i])))
        val difference = x - y - borrow
        borrow = (difference >> 8) & secretU32(u32(1))
        any = any | x
        i = i - 1
    }
    (ctIsNonZero(any) & ctIsNonZero(borrow)).declassify() != u32(0)
}
