import "abla/json"
import "../net/endpoint.ab"

// Reading Bitcoin through an Esplora API: mempool.space, Blockstream's, or your own electrs.

class BitcoinOutput(val index: int, val address: string, val value: int)
// Height, hash and time are -1, "" and 0 until it's mined.
class BitcoinTransaction(val txid: string, val confirmed: bool, val height: int, val blockHash: string, val blockTime: int, val fee: int, val firstInputAddress: string, val outputs: array<BitcoinOutput>)
class EsploraHeight(val ok: bool, val message: string, val height: int)
class EsploraTransactions(val ok: bool, val message: string, val transactions: array<BitcoinTransaction>, val complete: bool = false, val nextTxid: string = "")

fun esploraTransactionFrom(tx: Json): BitcoinTransaction {
    val status = tx.get("status")
    val mined = status.get("confirmed").asBoolean()
    val vin = tx.get("vin")
    val outputs: array<BitcoinOutput> = []
    val vout = tx.get("vout")
    for (n in 0 until vout.size()) outputs.append(BitcoinOutput(n, vout.at(n).getString("scriptpubkey_address"), vout.at(n).get("value").asInt()))
    BitcoinTransaction(tx.getString("txid"), mined, if (mined) status.getInt("block_height") else -1, if (mined) status.getString("block_hash") else "", if (mined) status.getInt("block_time") else 0, tx.get("fee").asInt(), if (vin.size() > 0) vin.at(0).get("prevout").getString("scriptpubkey_address") else "", outputs)
}
class EsploraClient(val endpoint: ChainEndpoint) {
    fun tipHeight(): EsploraHeight {
        val reply = this.endpoint.send("GET", "/blocks/tip/height")
        if (!reply.ok) return EsploraHeight(false, reply.message, 0)
        if (!reply.value.isNumber()) return EsploraHeight(false, "the tip isn't a number", 0)
        EsploraHeight(true, "", reply.value.asInt())
    }
    fun transaction(txid: string): EsploraTransactions {
        val reply = this.endpoint.send("GET", "/tx/$txid")
        if (!reply.ok) return EsploraTransactions(false, reply.message, [])
        EsploraTransactions(true, "", [esploraTransactionFrom(reply.value)], true)
    }
    // Unconfirmed first, then confirmed, newest first. At the page budget, ok/complete are false, transactions holds the
    // partial observations and nextTxid is the explicit continuation: pass it as afterTxid on the next call.
    fun addressTransactions(address: string, maxPages: int = 4, afterTxid: string = ""): EsploraTransactions {
        val out: array<BitcoinTransaction> = []
        if (maxPages < 1) return EsploraTransactions(false, "maxPages must be positive", out)
        var last = afterTxid
        var path = "/address/$address/txs${if (afterTxid == "") "" else "/chain/$afterTxid"}"
        for (page in 0 until maxPages) {
            val reply = this.endpoint.send("GET", path)
            if (!reply.ok) return EsploraTransactions(false, reply.message, [])
            if (!reply.value.isArray()) return EsploraTransactions(false, "the address list is not an array", [])
            var confirmed = 0
            for (tx in reply.value.values) {
                val read = esploraTransactionFrom(tx)
                out.append(read)
                if (read.confirmed) {
                    confirmed = confirmed + 1
                    last = read.txid
                }
            }
            if (confirmed < 25) return EsploraTransactions(true, "", out, true)
            path = "/address/$address/txs/chain/$last"
        }
        EsploraTransactions(false, "address history continues; resume with nextTxid", out, false, last)
    }
}
fun esploraClient(endpoint: ChainEndpoint): EsploraClient = EsploraClient(endpoint)
