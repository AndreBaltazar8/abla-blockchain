import "abla/crypto"

// Keccak-256 as Ethereum uses it: the original padding (0x01), not SHA3's (0x06).

private fun keccakWord(high: int, low: int): u64 = (u64(high) << 32) | u64(low)
private fun keccakRoundConstants(): array<u64> = [
    keccakWord(0, 1),
    keccakWord(0, 32898),
    keccakWord(2147483648, 32906),
    keccakWord(2147483648, 2147516416),
    keccakWord(0, 32907),
    keccakWord(0, 2147483649),
    keccakWord(2147483648, 2147516545),
    keccakWord(2147483648, 32777),
    keccakWord(0, 138),
    keccakWord(0, 136),
    keccakWord(0, 2147516425),
    keccakWord(0, 2147483658),
    keccakWord(0, 2147516555),
    keccakWord(2147483648, 139),
    keccakWord(2147483648, 32905),
    keccakWord(2147483648, 32771),
    keccakWord(2147483648, 32770),
    keccakWord(2147483648, 128),
    keccakWord(0, 32778),
    keccakWord(2147483648, 2147483658),
    keccakWord(2147483648, 2147516545),
    keccakWord(2147483648, 32896),
    keccakWord(0, 2147483649),
    keccakWord(2147483648, 2147516424)
]
private fun keccakRotations(): array<int> = [1, 3, 6, 10, 15, 21, 28, 36, 45, 55, 2, 14, 27, 41, 56, 8, 25, 43, 62, 18, 39, 61, 20, 44]
private fun keccakPositions(): array<int> = [10, 7, 11, 17, 18, 3, 5, 16, 8, 21, 24, 4, 15, 23, 19, 13, 12, 2, 20, 14, 22, 9, 6, 1]
private fun keccakRotate(value: u64, count: int): u64 = (value << count) | (value >> (64 - count))

private fun keccakPermute(var s: array<u64>): void {
    val constants = keccakRoundConstants()
    val rotations = keccakRotations()
    val positions = keccakPositions()
    val c: array<u64> = [u64(0), u64(0), u64(0), u64(0), u64(0)]
    for (round in 0 until 24) {
        for (x in 0 until 5) c[x] = s[x] ^ s[x + 5] ^ s[x + 10] ^ s[x + 15] ^ s[x + 20]
        for (x in 0 until 5) {
            val d = c[(x + 4) % 5] ^ keccakRotate(c[(x + 1) % 5], 1)
            for (y in 0 until 5) s[x + y * 5] = s[x + y * 5] ^ d
        }
        var last = s[1]
        for (i in 0 until 24) {
            val at = positions[i]
            val saved = s[at]
            s[at] = keccakRotate(last, rotations[i])
            last = saved
        }
        for (y in 0 until 5) {
            for (x in 0 until 5) c[x] = s[x + y * 5]
            for (x in 0 until 5) s[x + y * 5] = c[x] ^ ((~c[(x + 1) % 5]) & c[(x + 2) % 5])
        }
        s[0] = s[0] ^ constants[round]
    }
}
fun keccak256(value: string): string {
    val rate = 136
    var s: array<u64> = []
    for (i in 0 until 25) s.append(u64(0))
    val padded: array<int> = []
    for (i in 0 until value.size) padded.append(value[i])
    padded.append(1)
    while (padded.size % rate != 0) padded.append(0)
    padded[padded.size - 1] = padded[padded.size - 1] | 128
    var offset = 0
    while (offset < padded.size) {
        for (i in 0 until rate / 8) {
            var lane = u64(0)
            for (b in 0 until 8) lane = lane | (u64(padded[offset + i * 8 + b]) << (b * 8))
            s[i] = s[i] ^ lane
        }
        keccakPermute(s)
        offset = offset + rate
    }
    val out: array<int> = []
    for (i in 0 until 32) out.append(int((s[i / 8] >> ((i % 8) * 8)) & u64(255)))
    cryptoByteString(out)
}
